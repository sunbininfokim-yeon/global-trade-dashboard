# Local-only settings for running scripts/*.js on your own machine
# (node scripts/sync-policy-reference-data.js, etc.) without exporting
# environment variables by hand every time.
#
# Setup (one time):
#   1. cp .env.example .env.local
#   2. Open .env.local in a text editor and paste each value after the `=`.
#      Paste ONLY the value itself -- not an `export ...` line, not a
#      terminal command, just the key/token as copied from its source below.
#   3. Save. .env.local is in .gitignore, so it never gets committed.
#
# From then on, `node scripts/sync-policy-reference-data.js` (or any other
# scripts/*.js) picks these up automatically -- no export, no re-entering
# them in a new terminal.

# Supabase dashboard -> this project -> Project Settings -> API -> Project URL
SUPABASE_URL=

# Same page -> Project API keys -> service_role (NOT the "anon" key)
SUPABASE_SERVICE_ROLE_KEY=

# https://api.congress.gov/sign-up/ -- request a key, it arrives by email
CONGRESS_API_KEY=
