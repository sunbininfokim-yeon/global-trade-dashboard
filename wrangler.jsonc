{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "global-trade-dashboard",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Entry point for the Worker script. Without this, Cloudflare treats the
  // deployment as static-assets-only and _worker.js never runs, so every
  // /api/* route 404s and Variables/Secrets can't even be added in the
  // dashboard ("Worker that only has static assets").
  "main": "_worker.js",
  "assets": {
    "directory": "New for anti",
    "binding": "ASSETS"
  },
  // Shared response cache for the /api/* proxies. Without this binding
  // env.API_CACHE is undefined and every visitor triggers their own upstream
  // API call -- which blows through per-IP quotas like USDA FAS's 50
  // requests/day, since all visitors share this Worker's egress IP.
  // Kept separate from the brazil_agri namespace, which the nightly Python
  // bot owns.
  "kv_namespaces": [
    {
      "binding": "API_CACHE",
      "id": "35315eb44cfc4cd480c25794c0623c04"
    }
  ],
  // Every 6 hours the Worker's scheduled() handler tops up API_CACHE so
  // visitors never pay for a cold UN Comtrade query. warmComtradeCache()
  // skips any commodity whose KV entry is still fresh, so this frequency
  // does not mean four full re-fetches a day: oil/gas (48h TTL) and
  // gold/silver/copper (24h TTL) end up refreshed several times a day,
  // while the weekly-TTL commodities (most metals, all agri) are still
  // re-fetched roughly once a week -- just whichever of the four daily
  // ticks first finds them stale, not always the same time of day. The
  // real win from four ticks instead of one: after a change that
  // invalidates every cache key at once (a new HS code, a new reporter
  // list), the 8-per-run budget below clears the backlog in about a day
  // instead of three or four.
  "triggers": {
    "crons": ["0 */6 * * *"]
  }
}
