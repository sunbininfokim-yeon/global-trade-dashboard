{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "global-trade-dashboard",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Entry point for the Worker script. Without this, Cloudflare treats the
  // deployment as static-assets-only and _worker.js never runs, so every
  // /api/* route 404s and Variables/Secrets can't even be added in the
  // dashboard ("Worker that only has static assets").
  "main": "_worker.js",
  "assets": {
    "directory": "New for anti",
    "binding": "ASSETS"
  },
  // Shared response cache for the /api/* proxies. Without this binding
  // env.AGRI_DATA_KV is undefined and every visitor triggers their own
  // upstream API call -- which blows through per-IP quotas like USDA FAS's
  // 50 requests/day, since all visitors share this Worker's egress IP.
  "kv_namespaces": [
    {
      "binding": "AGRI_DATA_KV",
      "id": "8f828278cb654cf4bb709f9fcf7bbe1e"
    }
  ]
}
