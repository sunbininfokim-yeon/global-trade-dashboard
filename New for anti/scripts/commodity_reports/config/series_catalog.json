    {"series_id": "IEA_OMR", "label_ko": "IEA 월간 석유시장 보고", "base_weight": 2.0,
     "match_any": ["oil market report"]},
    {"series_id": "USGS_MCS", "label_ko": "USGS 광물자원 요약", "base_weight": 1.9,
     "match_any": ["mineral commodity summaries", "mineral industry surveys"]},
    {"series_id": "EU_SHORT_TERM_OUTLOOK", "label_ko": "EU 농산물 단기 전망", "base_weight": 1.6,
     "match_any": ["short-term outlook for eu agricultural markets", "cereals balance sheet"]},
    {"series_id": "WORLDSTEEL_CRUDE_STEEL", "label_ko": "세계철강협회 월간 조강 생산", "base_weight": 1.6,
     "match_any": ["crude steel production"],
     "commodities": ["iron_ore", "met_coal"]},
    {"series_id": "MPOB_SUPPLY_DEMAND", "label_ko": "MPOB 팜유 수급", "base_weight": 1.9,
     "match_any": ["palm oil supply and demand", "industry performance", "prestasi industri sawit",
                   "monthly palm oil statistics", "perangkaan bulanan", "palm oil stocks"],
     "commodities": ["palm_oil"]},
    {"series_id": "COCHILCO_COPPER_MARKET", "label_ko": "Cochilco 구리시장 보고", "base_weight": 1.7,
     "match_any": ["mercado internacional del cobre", "informe de tendencias del mercado del cobre"],
