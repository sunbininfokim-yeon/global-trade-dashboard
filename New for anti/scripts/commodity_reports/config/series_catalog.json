{
  "version": 1,
  "notes": [
    "The 'major report' definition, kept as data so it grows by editing this file rather than the scorer.",
    "match_any is matched case-insensitively against title + summary. base_weight multiplies the report's importance; label learning (cache/label_history.jsonl) multiplies it again.",
    "series_id is also the key the label CLI writes against, so renaming one resets its learned weight.",
    "covers_all: true makes commodities a union rather than a fallback, for reports that revise every commodity they list (WASDE, STEO, AEO) whatever their headline names.",
    "commodities is a fallback only: build.py uses it when the headline names none of this dashboard's tracked crops at all (a bare 'USDA releases September WASDE' wrapper headline revises a dozen commodities without naming one) -- a report that already names a crop keeps using that, series list or not."
  ],
  "series": [
    {"series_id": "USDA_WASDE", "label_ko": "WASDE 세계 수급전망", "base_weight": 2.2,
     "match_any": ["wasde", "world agricultural supply and demand"],
     "commodities": ["corn", "wheat", "soybeans", "rice", "cotton", "sugar"], "covers_all": true},
    {"series_id": "USDA_CROP_PRODUCTION", "label_ko": "USDA 작황 생산량", "base_weight": 2.0,
     "match_any": ["crop production report", "crop production:", "crop production —"],
     "commodities": ["corn", "wheat", "soybeans", "cotton", "rice"]},
    {"series_id": "USDA_PROSPECTIVE_PLANTINGS", "label_ko": "USDA 파종의향면적", "base_weight": 2.0,
     "match_any": ["prospective plantings", "acreage report"],
     "commodities": ["corn", "wheat", "soybeans", "cotton", "rice"]},
    {"series_id": "USDA_AG_PRICES", "label_ko": "USDA 농산물 가격지수", "base_weight": 1.6,
     "match_any": ["prices received index", "prices paid index", "agricultural prices"]},
    {"series_id": "USDA_GRAIN_STOCKS", "label_ko": "USDA 곡물 재고", "base_weight": 1.9,
     "match_any": ["grain stocks"],
     "commodities": ["corn", "wheat", "soybeans"]},
    {"series_id": "USDA_CROP_PROGRESS", "label_ko": "USDA 작황 진도", "base_weight": 1.5,
     "match_any": ["crop progress"],
     "commodities": ["corn", "wheat", "soybeans", "cotton"]},
    {"series_id": "USDA_EXPORT_SALES", "label_ko": "USDA 주간 수출판매", "base_weight": 1.4,
     "match_any": ["export sales report", "weekly export sales"],
     "commodities": ["corn", "wheat", "soybeans", "cotton", "rice"]},
    {"series_id": "USDA_GAIN", "label_ko": "USDA GAIN 주재관 보고", "base_weight": 1.8,
     "match_any": ["gain report", "global agricultural information network", "attaché report", "attache report",
                   "grain and feed", "oilseeds and products", "sugar annual", "sugar semi-annual", "coffee annual",
                   "coffee semi-annual", "cotton and products", "cocoa annual", "biofuels annual"]},
    {"series_id": "USDA_PSD", "label_ko": "USDA PSD 국가별 수급", "base_weight": 1.6,
     "match_any": ["production, supply and distribution", "psd online"]},
    {"series_id": "USDA_OUTLOOK", "label_ko": "USDA 품목별 아웃룩", "base_weight": 1.6,
     "match_any": ["wheat outlook", "feed outlook", "oil crops outlook", "rice outlook",
                   "sugar and sweeteners outlook", "cotton and wool outlook", "livestock outlook"]},
    {"series_id": "CONAB_SAFRA", "label_ko": "CONAB 브라질 작황", "base_weight": 2.1,
     "match_any": ["acompanhamento da safra", "levantamento de safra", "boletim da safra", "safra 20"]},
    {"series_id": "STATCAN_FIELD_CROPS", "label_ko": "캐나다 주요 작물 생산", "base_weight": 1.8,
     "match_any": ["production of principal field crops", "field crop reporting"]},
    {"series_id": "ABARES_CROP_REPORT", "label_ko": "ABARES 호주 작황", "base_weight": 1.9,
     "match_any": ["australian crop report", "agricultural commodities report"]},
    {"series_id": "FAO_FOOD_PRICE_INDEX", "label_ko": "FAO 식량가격지수", "base_weight": 1.9,
     "match_any": ["food price index"]},
    {"series_id": "FAO_CROP_PROSPECTS", "label_ko": "FAO 작황·식량수급 전망", "base_weight": 1.8,
     "match_any": ["crop prospects and food situation", "amis market monitor"]},
    {"series_id": "IGC_GRAIN_MARKET_REPORT", "label_ko": "IGC 곡물시장 보고", "base_weight": 1.9,
     "match_any": ["grain market report"]},
    {"series_id": "EIA_STEO", "label_ko": "EIA 단기 에너지 전망", "base_weight": 1.9,
     "match_any": ["short-term energy outlook", "steo"],
