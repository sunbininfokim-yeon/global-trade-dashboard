{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-trade-dashboard.example/schemas/shipping_capacity_scenario_grid_v1.schema.json",
  "title": "Shipping Capacity Scenario Grid v1",
  "type": "object",
  "required": ["schema_version", "artifact_type", "bundle_id", "generated_at", "ui_scenario_grid"],
  "properties": {
    "schema_version": {"const": "shipping-capacity-scenario-grid-v1"},
    "artifact_type": {"const": "scenario_grid"},
    "bundle_id": {"type": "string", "minLength": 20, "maxLength": 20},
    "generated_at": {"type": "string", "format": "date-time"},
    "ui_scenario_grid": {
      "type": "object",
      "required": ["status", "closure_pct_options", "duration_day_options", "fixed_horizon_days", "input_policy", "rows"],
      "properties": {
        "status": {"const": "precomputed_python_engine"},
        "input_policy": {
          "type": "object",
          "required": ["closure_pct_step", "duration_values_precomputed", "browser_recalculation", "warning_ko"],
          "properties": {
            "closure_pct_step": {"type": "integer", "minimum": 1},
            "duration_values_precomputed": {"const": true},
            "browser_recalculation": {"const": false}
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["key", "base_scenario_id", "closure_pct", "duration_days", "horizon_days", "summary", "routes"],
            "properties": {
              "summary": {
                "type": "object",
                "required": ["affected_route_count", "affected_baseline_dwt", "operational_capacity_absorbed_dwt", "affected_allocated_dwt_with_reserve", "relevant_global_type_fleet_dwt", "operational_capacity_absorbed_pct_of_affected_allocated", "operational_capacity_absorbed_pct_of_relevant_global_type_fleet", "commercially_unavailable_pct_of_affected_allocated", "commercially_available_pct_of_affected_allocated", "ship_type_breakdown", "cargo_segment_breakdown", "reroute_receivers", "capacity_denominator_warning"],
                "properties": {
                  "reroute_receivers": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["id", "name_ko", "source_chokepoint_id", "affected_route_count", "rerouted_cargo_tonnes_horizon", "rerouted_in_transit_cargo_tonnes_horizon", "additional_service_capacity_dwt", "ship_type_breakdown", "warning_ko", "status"],
                      "properties": {
                        "status": {"const": "modelled_reroute_receiver_not_observed_traffic"},
                        "affected_route_count": {"type": "integer", "minimum": 1},
                        "rerouted_cargo_tonnes_horizon": {"type": "number", "minimum": 0},
                        "rerouted_in_transit_cargo_tonnes_horizon": {"type": "number", "minimum": 0},
                        "additional_service_capacity_dwt": {"type": "number", "minimum": 0},
                        "ship_type_breakdown": {"type": "array"}
                      }
                    }
                  },
                  "ship_type_breakdown": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["ship_type", "affected_route_count", "affected_baseline_dwt", "affected_allocated_dwt_with_reserve", "relevant_global_type_fleet_dwt", "operational_capacity_absorbed_dwt", "operational_capacity_absorbed_pct_of_affected_allocated", "commercially_unavailable_dwt", "commercially_available_dwt", "backlog_cargo_tonnes_horizon", "weighted_traffic_change_pct", "scope"],
                      "properties": {
                        "ship_type": {"enum": ["container", "dry_bulk", "tanker"]}
                      }
                    }
                  },
                  "cargo_segment_breakdown": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["cargo_segment", "affected_route_count", "affected_baseline_dwt", "affected_allocated_dwt_with_reserve", "operational_capacity_absorbed_dwt", "commercial_capacity_gap_dwt", "commercially_unavailable_dwt", "backlog_cargo_tonnes_horizon", "rerouted_in_transit_cargo_tonnes_horizon", "weighted_traffic_change_pct", "global_fleet_denominator_status", "scope"],
                      "properties": {
                        "cargo_segment": {"type": "string"},
                        "global_fleet_denominator_status": {"enum": ["lng_only_global_dwt_not_available_free", "not_applicable_to_cargo_segment"]}
                      }
                    }
                  }
                }
              },
              "routes": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["route_id", "ship_type", "baseline_required_dwt", "allocated_dwt_with_reserve", "continuity_required_dwt", "operational_capacity_absorbed_dwt", "operational_capacity_absorbed_pct_of_route_allocated", "commercially_unavailable_dwt", "commercially_unavailable_pct_of_route_allocated", "traffic_change_pct"]
                }
              }
            }
          }
        }
      }
    }
  }
}
