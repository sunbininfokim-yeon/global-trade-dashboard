{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://global-trade-dashboard.example/schemas/shipping_capacity_v1.schema.json",
  "title": "Shipping Capacity Snapshot v1",
  "type": "object",
  "required": ["schema_version", "artifact_type", "bundle_id", "generated_at", "artifact_manifest", "coverage_summary", "model", "ui_delivery_contract", "fleet", "lng_fleet", "chokepoints", "chokepoints_live", "routes", "route_catalog", "scenarios", "scenario_summary", "live_display", "live_data_quality", "environment", "comtrade_routes", "portwatch_port_context", "market_signals", "pdf_reports"],
  "properties": {
    "official_cargo_monitor": {
      "type": "object",
      "required": ["contract_version", "generated_at", "status", "api_keys_required", "collection_policy", "sources", "chokepoints"],
      "properties": {
        "contract_version": {"const": "official-chokepoint-cargo-v1"},
        "generated_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["available", "cached", "unavailable"]},
        "api_keys_required": {"type": "array", "maxItems": 0},
        "sources": {
          "type": "object",
          "required": ["eia", "imo", "iea"],
          "additionalProperties": {
            "type": "object",
            "required": ["status", "api_key_required", "source_url"],
            "properties": {
              "status": {"enum": ["fetched", "cached_fallback", "unavailable", "cached_offline", "not_fetched"]},
              "api_key_required": {"const": false}
            }
          }
        },
        "chokepoints": {
          "type": "object",
          "required": ["hormuz", "suez"],
          "additionalProperties": {
            "type": "object",
            "required": ["reference_cards", "supplementary_reference_cards", "reference_comparison_policy", "reported_series", "daily_chart", "daily_crude_barrels", "transit_assessment", "commodity_breakdown_status"],
            "properties": {
              "reference_cards": {"type": "array", "items": {"type": "object", "required": ["value", "unit", "period_start", "period_end", "publisher", "geography_scope", "source_url", "warning_ko"]}},
              "supplementary_reference_cards": {"type": "array", "items": {"type": "object", "required": ["value", "unit", "period_start", "period_end", "publisher", "geography_scope", "source_url", "license", "attribution", "warning_ko"], "properties": {"publisher": {"const": "IEA"}, "frequency": {"const": "monthly"}, "cargo_category": {"const": "total_oil"}, "unit": {"const": "barrels_per_day"}, "value": {"type": "number", "minimum": 0}, "license": {"const": "CC BY 4.0"}}}},
              "reference_comparison_policy": {"const": "group_by_publisher_period_scope_and_commodity_never_mix_composition"},
              "reported_series": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["cargo_category", "period_start", "period_end", "frequency", "statistic", "value", "unit", "geography_scope", "publisher", "source_url", "source_published_at", "retrieved_at", "evidence_class", "warning_ko"],
                  "properties": {
                    "cargo_category": {"enum": ["total_oil", "crude_condensate", "petroleum_products", "lng"]},
                    "period_start": {"type": "string", "format": "date"},
                    "period_end": {"type": "string", "format": "date"},
                    "frequency": {"enum": ["quarterly", "monthly"]},
                    "statistic": {"const": "period_daily_mean"},
                    "value": {"type": ["number", "null"], "minimum": 0},
                    "unit": {"enum": ["barrels_per_day", "billion_cubic_feet_per_day"]},
                    "evidence_class": {"const": "institution_estimate"},
                    "source_url": {"type": "string", "format": "uri"},
                    "source_published_at": {"type": "string", "format": "date"},
                    "retrieved_at": {"type": "string", "format": "date-time"}
                  }
                }
              },
              "daily_chart": {
                "type": "object",
                "required": ["source_path", "unit", "classification", "ship_type_keys", "warning_ko"],
                "properties": {
                  "unit": {"const": "estimated_trade_tonnes_per_day"},
                  "classification": {"const": "ship_type_not_commodity"}
                }
              },
              "daily_crude_barrels": {
                "type": "object",
                "required": ["status", "value", "unit"],
                "properties": {"value": {"type": "null"}}
              },
              "transit_assessment": {
                "type": "object",
                "required": ["status", "success_probability", "insurance_availability", "advisory_references", "warning_ko"],
                "properties": {"success_probability": {"type": "null"}}
              }
            }
          }
        }
      }
    },
    "hormuz_reconstruction": {
      "type": "object",
      "required": ["contract_version", "generated_at", "status", "api_keys_required", "method_document", "headline", "mass_balance", "producer_exports", "importer_receipts", "sar_coverage", "identifiability", "rejected_shortcuts", "sources"],
      "properties": {
        "contract_version": {"const": "hormuz-reconstruction-v1"},
        "generated_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["available", "cached", "unavailable"]},
        "api_keys_required": {"type": "array", "maxItems": 0},
        "headline": {
          "type": "object",
          "required": ["status", "value", "range", "unit", "display_ko", "blocking_terms", "warning_ko"],
          "properties": {
            "status": {"enum": ["not_computed_insufficient_inputs", "computed_monthly_unexplained_range"]},
            "value": {"type": ["number", "null"]},
            "range": {"type": ["object", "null"]}
          },
          "if": {"properties": {"status": {"const": "not_computed_insufficient_inputs"}}},
          "then": {"properties": {"value": {"type": "null"}, "range": {"type": "null"}, "blocking_terms": {"type": "array", "minItems": 1}}}
        },
        "mass_balance": {
          "type": "object",
          "required": ["boundary", "period", "unit", "terms", "result"],
          "properties": {
            "unit": {"const": "barrels_cumulative_over_period"},
            "terms": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {
                "type": "object",
                "required": ["id", "label_ko", "status", "value", "candidates", "required_ko", "unlock_ko"],
                "properties": {
                  "status": {"enum": ["qualified", "unqualified_input", "missing_no_free_source"]},
                  "candidates": {"type": "array", "items": {"type": "object", "required": ["source", "input_status", "reasons", "reason_labels_ko"]}}
                },
                "if": {"properties": {"status": {"not": {"const": "qualified"}}}},
                "then": {"properties": {"value": {"type": "null"}, "low": {"type": "null"}, "high": {"type": "null"}}}
              }
            },
            "result": {
              "type": "object",
              "required": ["status", "missing_terms"],
              "properties": {"status": {"enum": ["hold_inputs_missing", "hold_negative_residual_boundary_mismatch", "computed"]}}
            }
          }
        },
        "producer_exports": {
          "type": "object",
          "required": ["status", "unit", "months", "producers", "hormuz_only_group", "warning_ko"],
          "properties": {
            "unit": {"const": "thousand_barrels_per_day"},
            "producers": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["iso2", "route_class", "series"],
                "properties": {
                  "route_class": {"enum": ["hormuz_only_seaborne", "bypass_capable", "outside_strait"]},
                  "series": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["period", "value", "status"],
                      "if": {"properties": {"status": {"not": {"const": "reported"}}}},
                      "then": {"properties": {"value": {"type": "null"}}}
                    }
                  }
                }
              }
            }
          }
        },
        "importer_receipts": {
          "type": "object",
          "required": ["status", "unit", "months", "importers", "warning_ko"],
          "properties": {"unit": {"const": "tonnes_net_weight"}}
        },
        "sar_coverage": {
          "type": "object",
          "required": ["status", "bbox", "acquisition_dates", "acquisitions", "vessel_detection", "warning_ko"],
          "properties": {"vessel_detection": {"type": "null"}}
        },
        "identifiability": {
          "type": "object",
          "required": ["formula", "terms", "result"],
          "properties": {"result": {"type": "null"}}
        },
        "rejected_shortcuts": {"type": "array", "minItems": 1},
        "sources": {
          "type": "object",
          "required": ["jodi", "comtrade", "sentinel1"],
          "additionalProperties": {
            "type": "object",
            "required": ["status", "api_key_required", "source_url", "terms_url", "attribution"],
            "properties": {
              "status": {"enum": ["fetched", "cached_fallback", "unavailable", "cached_offline", "not_fetched"]},
              "api_key_required": {"const": false}
            }
          }
        }
      }
    },
    "hormuz_bypass_monitor": {
      "type": "object",
      "required": ["contract_version", "generated_at", "status", "api_keys_required", "route", "threat", "yanbu_port_activity", "official_crude_comparison", "sources"],
      "properties": {
        "contract_version": {"const": "hormuz-bypass-v1"},
        "generated_at": {"type": "string", "format": "date-time"},
        "status": {"enum": ["available", "cached", "unavailable"]},
        "api_keys_required": {"type": "array", "maxItems": 0},
        "route": {"type": "object", "required": ["label_ko", "segments"]},
        "threat": {
          "type": "object",
          "required": ["status", "reviewed_at", "events"],
          "properties": {
            "status": {"enum": ["recent_events_reported", "no_recent_events_in_log", "log_review_stale"]},
            "events": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["date", "date_precision", "event_ko", "evidence_class", "sources"],
                "properties": {
                  "evidence_class": {"enum": ["press_report", "official_statement"]},
                  "sources": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["publisher", "url"]}}
                }
              }
            }
          }
        },
        "yanbu_port_activity": {
          "type": "object",
          "required": ["status", "unit", "monthly", "warning_ko"],
          "properties": {"unit": {"const": "estimated_tanker_export_tonnes_per_day"}}
        },
        "official_crude_comparison": {
          "type": "object",
          "required": ["publisher", "frequency", "cargo_category", "unit", "series", "diverted_volume"],
          "properties": {"diverted_volume": {"type": "null"}}
        },
        "sources": {
          "type": "object",
          "required": ["portwatch_ports"],
          "additionalProperties": {
            "type": "object",
            "required": ["status", "api_key_required", "source_url"],
            "properties": {
              "status": {"enum": ["fetched", "cached_fallback", "unavailable", "cached_offline", "not_fetched"]},
              "api_key_required": {"const": false}
            }
          }
        }
      }
    },
    "schema_version": {"const": "shipping-capacity-v1"},
    "artifact_type": {"const": "screen_snapshot"},
    "bundle_id": {"type": "string", "minLength": 20, "maxLength": 20},
    "generated_at": {"type": "string", "format": "date-time"},
    "artifact_manifest": {
      "type": "object",
      "required": ["screen", "diagnostics", "backtests"]
    },
    "coverage_summary": {
      "type": "object",
      "required": ["modeled_route_count", "public_flow_route_count", "bidirectional_service_count", "cargo_segments"]
    },
    "ui_delivery_contract": {
      "type": "object",
      "required": ["contract_version", "calculation_owner", "unavailable_value_rule", "views"],
      "properties": {
        "contract_version": {"const": "shipping-ui-delivery-v2"},
        "calculation_owner": {"const": "python_shipping_capacity_engine"},
        "views": {
          "type": "object",
          "required": ["global_fleet", "route_service", "chokepoint_detail", "environment"]
        }
      }
    },
    "fleet": {
      "type": "object",
      "required": ["as_of", "world_total_dwt", "fleet_by_type"]
    },
    "lng_fleet": {
      "type": "object",
      "required": ["status", "liquefied_gas_carriers_dwt", "lng_only_dwt", "model_use", "warning_ko"]
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ship_type", "cargo_segment", "input_status", "baseline", "operational_profile"],
        "properties": {
          "service_type": {"type": "string"},
          "vessel_class": {"type": ["string", "null"]},
          "directions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "origin", "destination", "input_status"],
              "properties": {
                "annual_cargo_tonnes": {"type": ["number", "null"], "minimum": 0}
              }
            }
          },
          "cargo_segment": {"type": "string"},
          "operational_profile": {
            "type": "object",
            "required": ["normal", "chokepoint_alternatives", "method", "input_status", "warning"],
            "properties": {
              "normal": {
                "type": "object",
                "required": ["distance_nm_one_way", "speed_knots", "sea_days_one_way", "port_days_round_trip", "cycle_days_round_trip"]
              },
              "chokepoint_alternatives": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["chokepoint_id", "reroute_available", "baseline_distance_nm_one_way", "reroute_extra_nm_one_way", "rerouted_distance_nm_one_way", "baseline_sea_days_one_way", "reroute_extra_days_one_way", "rerouted_sea_days_one_way", "baseline_cycle_days", "reroute_extra_cycle_days", "rerouted_cycle_days", "cycle_increase_pct", "exposure_share", "input_status", "warning"],
                  "properties": {
                    "reroute_extra_nm_one_way": {"type": ["number", "null"], "minimum": 0},
                    "rerouted_distance_nm_one_way": {"type": ["number", "null"], "minimum": 0},
                    "reroute_extra_days_one_way": {"type": ["number", "null"], "minimum": 0},
                    "rerouted_sea_days_one_way": {"type": ["number", "null"], "minimum": 0},
                    "reroute_extra_cycle_days": {"type": ["number", "null"], "minimum": 0},
                    "rerouted_cycle_days": {"type": ["number", "null"], "minimum": 0},
                    "cycle_increase_pct": {"type": ["number", "null"], "minimum": 0},
                    "distance_evidence": {"type": ["object", "null"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "chokepoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "portwatch_id", "coordinates", "risk_context", "scenario_availability"],
        "properties": {
          "risk_context": {
            "type": "object",
            "required": ["primary_constraint_type", "primary_constraint_label_ko", "mechanism_ko", "scenario_interpretation_ko"]
          },
          "scenario_availability": {"enum": ["linked_model_scenarios", "route_link_no_preset_scenario", "observed_monitor_only_no_route_model"]}
        }
      }
    },
    "chokepoints_live": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["metrics", "history", "history_metric_key", "history_field", "history_unit", "history_point_count", "history_status", "daily_averages"],
        "properties": {
          "history": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "value"],
              "properties": {
                "date": {"type": "string", "format": "date"},
                "value": {"type": "number", "minimum": 0}
              }
            }
          },
          "history_metric_key": {"enum": ["all", "container", "dry_bulk", "general_cargo", "tanker"]},
          "history_field": {"type": "string"},
          "history_unit": {"const": "estimated_trade_tonnes_per_day"},
          "history_point_count": {"type": "integer", "minimum": 0},
          "history_status": {"enum": ["observed_daily_estimated_trade_volume", "unavailable_cached_summary_only"]},
          "metric_histories": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["metric_key", "field", "unit", "definition", "history", "history_point_count", "history_status", "daily_averages"],
              "properties": {
                "metric_key": {"enum": ["all", "container", "dry_bulk", "general_cargo", "tanker"]},
                "field": {"type": "string"},
                "unit": {"const": "estimated_trade_tonnes_per_day"},
                "definition": {"type": "string"},
                "history": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["date", "value"],
                    "properties": {
                      "date": {"type": "string", "format": "date"},
                      "value": {"type": "number", "minimum": 0}
                    }
                  }
                },
                "history_point_count": {"type": "integer", "minimum": 0},
                "history_status": {"enum": ["observed_daily_estimated_trade_volume", "unavailable_cached_summary_only"]},
                "daily_averages": {"type": "object"}
              }
            }
          },
          "daily_averages": {
            "type": "object",
            "required": ["status", "unit", "latest_daily_observation", "trailing_7d_average", "prior_28d_average", "warning_ko"],
            "properties": {
              "status": {"enum": ["observed_daily_estimated_trade_volume", "unavailable_cached_summary_only"]},
              "unit": {"const": "estimated_trade_tonnes_per_day"},
              "latest_daily_observation": {"type": ["object", "null"]},
              "trailing_7d_average": {"type": "object"},
              "prior_28d_average": {"type": "object"},
              "warning_ko": {"type": "string"}
            }
          }
        }
      }
    },
    "route_catalog": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "ship_type", "vessel_class", "name_ko", "model_status"]
      }
    },
    "event_observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["event_id", "chokepoint_id", "status", "as_of", "observations", "warning_ko"],
        "properties": {
          "status": {"const": "official_observation_timeline"},
          "as_of": {"type": "string", "format": "date"},
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["date", "metric", "value", "qualifier", "scope", "source_name", "source_url"],
              "properties": {
                "date": {"type": "string", "format": "date"},
                "value": {"type": ["number", "null"], "minimum": 0},
                "display_value": {"type": "string"},
                "source_url": {"type": "string", "format": "uri"}
              }
            }
          }
        }
      }
    },
    "live_display": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "chokepoint_id",
          "metric_key",
          "headline_label_ko",
          "trade_volume_shortfall_fraction",
          "trade_volume_shortfall_pct_rounded",
          "basis_label_ko",
          "residual_label_ko",
          "remaining_trade_volume_ratio",
          "remaining_trade_volume_pct_rounded",
          "metric_unit",
          "signal_type",
          "stale_days",
          "is_stale",
          "fallback_used",
          "warning_ko"
        ],
        "properties": {
          "trade_volume_shortfall_fraction": {"type": "number", "minimum": 0, "maximum": 1},
          "remaining_trade_volume_ratio": {"type": "number", "minimum": 0, "maximum": 1},
          "metric_unit": {"const": "estimated_trade_tonnes_per_day"},
          "signal_type": {"const": "observed_estimated_trade_volume_shortfall"}
        }
      }
    },
    "live_data_quality": {
      "type": "object",
      "required": ["freshness_threshold_days", "fresh_count", "stale_count", "fallback_count", "status"]
    },
    "scenario_signal_comparison": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario_id", "observed_trade_volume_shortfall_fraction", "preset_scenario_blockage_fraction", "absolute_gap_percentage_points", "scope", "comparison_status", "not_validated_fields"],
        "properties": {
          "observed_trade_volume_shortfall_fraction": {"type": "number", "minimum": 0, "maximum": 1},
          "preset_scenario_blockage_fraction": {"type": "number", "minimum": 0, "maximum": 1},
          "comparison_status": {"const": "not_empirical_calibration"}
        }
      }
    },
    "model_review": {
      "type": "object",
      "required": ["model_version", "status", "roles", "source_of_truth", "provisional_assumptions"]
    },
    "environment": {
      "type": "object",
      "required": ["contract_version", "status", "methodology_ko", "warnings_ko", "sources", "pathways", "scenarios"],
      "properties": {
        "contract_version": {"const": "environment-pathways-v1"},
        "pathways": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["id", "name_ko", "policy_status", "description_ko"],
            "properties": {
              "id": {"enum": ["imo_adopted", "accelerated", "deferred"]},
              "policy_status": {"enum": ["official_adopted_path", "counterfactual_not_adopted"]}
            }
          }
        },
        "scenarios": {
          "type": "array",
          "minItems": 15,
          "maxItems": 15,
          "items": {
            "type": "object",
            "required": [
              "id",
              "year",
              "status",
              "pathway_id",
              "pathway_name_ko",
              "pathway_policy_status",
              "behavior_assumption_status",
              "regulatory_inputs",
              "physical_allocated_dwt",
              "effective_service_capacity_dwt",
              "effective_dwt_loss",
              "effective_capacity_retention_rate",
              "baseline_required_dwt",
              "same_service_required_dwt",
              "additional_required_vs_baseline_dwt",
              "capacity_gap_vs_allocated_dwt",
              "ship_type_breakdown",
              "scope",
              "effective_capacity_retention_rate_range",
              "same_service_required_dwt_range"
            ],
            "properties": {
              "year": {"type": "integer", "minimum": 2026, "maximum": 2030},
              "pathway_id": {"enum": ["imo_adopted", "accelerated", "deferred"]},
              "behavior_assumption_status": {"const": "provisional_sensitivity_seed_not_observed_operator_behavior"},
              "regulatory_inputs": {
                "type": "object",
                "required": ["cii_reduction_vs_2019_pct", "cii_status", "fueleu_ghg_intensity_reduction_vs_2020_pct", "fueleu_status", "eu_ets_emissions_coverage_for_reporting_year_pct", "eu_ets_status", "eu_ets_gases"]
              },
              "ship_type_breakdown": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "required": ["ship_type", "representative_route_count", "physical_allocated_dwt", "effective_service_capacity_dwt", "effective_dwt_loss", "effective_capacity_retention_rate", "same_service_required_dwt", "additional_required_vs_baseline_dwt", "capacity_gap_vs_allocated_dwt"],
                  "properties": {
                    "ship_type": {"enum": ["container", "dry_bulk", "tanker"]}
                  }
                }
              }
            }
          }
        }
      }
    },
    "container": {
      "type": "object",
      "required": ["status", "sources", "quality_gates", "context", "fetch_errors", "route_volume_status"]
    },
    "comtrade_routes": {
      "type": "object",
      "required": ["status", "route_count", "history"]
    },
    "portwatch_port_context": {
      "type": "object",
      "required": ["status", "groups", "identification_boundary"]
    },
    "market_signals": {
      "type": "object",
      "required": ["status", "signals", "identification_boundary", "warning_ko"]
    },
    "pdf_reports": {
      "type": "object",
      "required": ["status", "sources", "errors"]
    },
    "event_response_profiles": {
      "type": "object",
      "required": ["status", "profiles", "warning_ko"]
    },
    "historical_event_calibration": {
      "type": "object",
      "required": ["status", "generated_at", "identification_boundary", "events", "profile_evidence"],
      "properties": {
        "status": {"const": "throughput_calibrated_behavior_partition_partially_identified"},
        "generated_at": {"type": "string", "format": "date-time"},
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["event_id", "event_type", "chokepoint_id", "start_date", "end_date", "primary_metric", "primary_result", "metrics", "throughput_calibration_status", "behavior_partition_status"],
            "properties": {
              "start_date": {"type": "string", "format": "date"},
              "end_date": {"type": "string", "format": "date"},
              "throughput_calibration_status": {"const": "calibrated_observed_throughput"},
              "behavior_partition_status": {"const": "not_identified_by_single_chokepoint_throughput"},
              "primary_result": {
                "type": "object",
                "required": ["status", "observed_event_to_baseline_ratio", "observed_mean_shortfall_fraction", "bootstrap", "placebo_test", "evidence_grade"]
              }
            }
          }
        },
        "profile_evidence": {"type": "object", "minProperties": 1}
      }
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "chokepoint_id",
          "event_type",
          "closure_fraction",
          "residual_throughput_rate",
          "duration_days",
          "horizon_days"
        ],
        "properties": {
          "event_type": {"type": "string"},
          "closure_fraction": {"type": "number", "minimum": 0, "maximum": 1},
          "residual_throughput_rate": {"type": "number", "minimum": 0, "maximum": 1},
          "insurance_unavailable_share": {"type": "number", "minimum": 0, "maximum": 1},
          "onboard_waiting_share": {"type": "number", "minimum": 0, "maximum": 1},
          "trapped_days": {"type": "number", "minimum": 0}
        }
      }
    },
    "scenario_summary": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "event_type",
          "effective_blockage_fraction",
          "residual_throughput_rate",
          "backlog_cargo_tonnes_horizon",
          "rerouted_in_transit_cargo_tonnes_horizon",
          "trapped_loaded_dwt",
          "commercially_available_dwt",
          "affected_allocated_dwt_with_reserve",
          "relevant_global_type_fleet_dwt",
          "operational_capacity_absorbed_pct_of_affected_allocated",
          "operational_capacity_absorbed_pct_of_relevant_global_type_fleet",
          "commercially_unavailable_pct_of_affected_allocated",
          "commercially_available_pct_of_affected_allocated",
          "capacity_denominator_warning",
          "ship_type_breakdown",
          "cargo_segment_breakdown",
          "weighted_served_flow_index"
        ],
        "properties": {
          "reroute_receivers": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "source_chokepoint_id",
                "affected_route_count",
                "rerouted_cargo_tonnes_horizon",
                "additional_service_capacity_dwt",
                "status",
                "warning_ko"
              ],
              "properties": {
                "status": {"const": "modelled_reroute_receiver_not_observed_traffic"},
                "affected_route_count": {"type": "integer", "minimum": 1},
                "rerouted_cargo_tonnes_horizon": {"type": "number", "minimum": 0},
                "additional_service_capacity_dwt": {"type": "number", "minimum": 0}
              }
            }
          },
          "behavior_sensitivity": {
            "type": "object",
            "required": ["status", "event_throughput_held_fixed", "path_count", "paths", "ranges", "warning_ko"],
            "properties": {
              "status": {"const": "deterministic_joint_paths_not_probability_interval"},
              "event_throughput_held_fixed": {"const": true},
              "path_count": {"type": "integer", "minimum": 2},
              "paths": {"type": "array", "minItems": 2},
              "ranges": {"type": "object"}
            }
          }
        }
      }
    }
  }
}
