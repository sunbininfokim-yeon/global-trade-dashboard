{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "chokepoint_stress_v1.schema.json",
  "title": "Home-board chokepoint stress composite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "as_of",
    "index_pct",
    "worst_id",
    "worst_change_pct",
    "contributor_count",
    "method",
    "interpretation",
    "freshness_note",
    "source",
    "components"
  ],
  "properties": {
    "schema_version": { "const": "chokepoint-stress-v1" },
    "generated_at": { "type": "string", "format": "date-time" },
    "as_of": { "type": "string", "format": "date" },
    "index_pct": { "type": "number" },
    "worst_id": { "type": "string", "minLength": 1 },
    "worst_change_pct": { "type": "number" },
    "contributor_count": { "type": "integer", "minimum": 1 },
    "method": { "const": "arithmetic_mean_of_chokepoints_live.metrics.all.change_pct" },
    "interpretation": { "type": "string", "minLength": 1 },
    "freshness_note": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "upstream", "url"],
      "properties": {
        "dataset": { "const": "shipping_capacity_v1.json" },
        "upstream": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_ko",
          "name_en",
          "as_of",
          "change_pct",
          "current_7d_mean_dwt",
          "prior_28d_mean_dwt"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name_ko": { "type": "string", "minLength": 1 },
          "name_en": { "type": "string", "minLength": 1 },
          "as_of": { "type": "string", "format": "date" },
          "change_pct": { "type": "number" },
          "current_7d_mean_dwt": { "type": "number", "minimum": 0 },
          "prior_28d_mean_dwt": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    }
  }
}
