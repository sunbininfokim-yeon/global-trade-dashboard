 "orientation": {
  "note": "한 줄의 좌우가 아니다. 상원 야당·소수 표시만 상원 페이지가 붙인 말이다. 나머지는 교섭단체 이름과 그동안의 정책 축을 읽는 설명이다.",
  "poles": [
   {
    "pole": "대통령 진영",
    "groups": [
     "Ensemble pour la République",
     "Les Démocrates",
     "Horizons & Indépendants"
    ],
    "line": "유럽연합과 대서양 동맹을 유지하는 중도. 경제는 기업·재정 기율 쪽이다. 오리종은 그 안에서 중도우다."
   },
   {
    "pole": "좌파",
    "groups": [
     "La France insoumise - Nouveau Front Populaire",
     "Socialistes et apparentés",
     "Écologiste et Social",
     "Gauche Démocrate et Républicaine"
    ],
    "line": "마크롱 경제정책의 반대편. 불복은 급진 좌파, 사회당은 사회민주, 생태는 녹색 좌파, 민주공화좌파는 공산당 계열이다. 외교에서는 나토·현행 유럽연합 운영에 더 비판적이다."
   },
   {
    "pole": "우파",
    "groups": [
     "Droite Républicaine",
     "Union des droites pour la République"
    ],
    "line": "공화우파는 옛 공화당 계열의 전통 우파다. 공화국을 위한 우파연합은 그 오른쪽의 별도 교섭단체다."
   },
   {
    "pole": "국민 우파, 기존 중도 집권에 대한 대안",
    "groups": [
     "Rassemblement National"
    ],
    "line": "하원 제1교섭단체. 이민 제한, 국민 우선, 현행 유럽 통합에 거리. 집권 중도와 좌파 양쪽의 대안 자리다. 교섭단체 의장은 셰뉘다."
   },
   {
    "pole": "한 이념으로 묶이지 않음",
    "groups": [
     "Libertés, Indépendants, Outre-mer et Territoires"
    ],
    "line": "해외영토와 지역 의원 묶음이다. 좌우 한 진영으로 세지 않는다."
   }
  ]
 }
