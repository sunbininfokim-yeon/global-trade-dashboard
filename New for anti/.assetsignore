# ~6MB ICRISAT blob — train-time only; never needed by the browser.
# Kept in git so Actions can refresh it without shipping to every visitor.
public/data/icrisat_crop_production.json

# 매크로 프로토타입 (Cursor). 와이어·인터랙션 참고용으로 저장소에는 두되,
# 본 화면은 app.js 가 그리므로 배포본에 같은 기능의 낡은 사본이 공개되면 안 된다.
macro_monitor.html
macro_monitor.js
macro_monitor.css

# 2026-11-24: Workers Free caps a version at 20,000 static files; main reached
# 20,119 and every deploy failed. Per-state election evidence (1,324 files) is
# read only by scripts/election_watch at build time -- no browser code fetches
# it (grep js/ app.js for "state_evidence": none). Its index stays published.
public/data/usa_election_state_evidence
public/data/usa_election_state_evidence/**
